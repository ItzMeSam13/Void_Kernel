# ── Void Kernel — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# Never commit the actual .env to version control.

# ── App ────────────────────────────────────────────────────────────────────
DEBUG=false

# ── Redis (ARQ job queue + SHA-256 result cache) ───────────────────────────
# Local dev: redis://localhost:6379
# Docker:    redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini (Module 7 explanation + Module 6 evidence judge) ───────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── Tavily (Module 6 adversarial web search) ──────────────────────────────
TAVILY_API_KEY=your-tavily-api-key

# ── Google Fact Check Tools API (Module 6) ────────────────────────────────
GOOGLE_FACT_CHECK_API_KEY=your-google-fact-check-key

# ── SerpApi reverse-image search (Module 5, optional / feature-flagged) ───
ENABLE_SERPAPI_REVERSE_IMAGE=false
SERPAPI_KEY=

# ── Cache TTL ─────────────────────────────────────────────────────────────
RESULT_CACHE_TTL_SECONDS=604800  # 7 days
