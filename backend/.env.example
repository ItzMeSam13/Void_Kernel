# Copy to backend/.env (already gitignored) and fill in what you have.
# Every var below is optional — Person 1A's modules (Module 2B / 5 / 6) are
# designed to fail honest and keep working with any subset missing.

# --- Module 6 — LLM backend (claim splitting + evidence judging) ---------
# 'ollama' (default, local/offline, no key needed) or 'gemini'.
FACTCHECK_LLM_BACKEND=ollama
OLLAMA_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
# Only read when FACTCHECK_LLM_BACKEND=gemini:
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Module 6 — adversarial search + fact-check lookup --------------------
TAVILY_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# --- Module 5 — reference_media store (Supabase/Postgres) -----------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Module 5 — reverse-image search (Phase 4 stretch, paid, off by default)
ENABLE_REVERSE_SEARCH=false
SERPAPI_KEY=
